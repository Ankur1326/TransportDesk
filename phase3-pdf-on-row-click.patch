new file mode 100644
index 0000000..37601b1
--- /dev/null
+++ b/src/app/(print)/admin/lr/[id]/page.tsx
@@ -0,0 +1,92 @@
+import type { Metadata } from "next";
+import { notFound, redirect } from "next/navigation";
+import mongoose from "mongoose";
+
+import dbConnect from "@/lib/db";
+import ConsignmentModel from "@/models/Consignment";
+import { companyFilter, requireCompany } from "@/lib/company-scope";
+import { loadCompanySettings } from "@/lib/company-settings-server";
+import { LR_COPY_LABELS, parseCopies } from "@/lib/lr-copies";
+import { LorryCopy, LRStyles, type CopyName } from "@/components/billing/Printpreview";
+import { PrintToolbar } from "./PrintToolbar";
+
+/**
+ * Bare, server-rendered LR sheet — NO sidebar, session provider or app shell.
+ *
+ * Two jobs:
+ *   1. It is the page headless Chromium loads to produce the PDF served by
+ *      /api/admin/consignments/[id]/pdf (JavaScript is switched off there, so
+ *      nothing hydrates).
+ *   2. It is the fallback when Chromium can't run on the host: the PDF route
+ *      redirects here with ?toolbar=1 so the user can Print / Save as PDF.
+ *
+ * Lives in the `(print)` route group so the `(app)` layout never wraps it.
+ * /admin/* is still protected by src/proxy.ts and the page re-checks the
+ * session and scopes the query to the signed-in company.
+ */
+export const dynamic = "force-dynamic";
+
+type Props = {
+  params: Promise<{ id: string }>;
+  searchParams: Promise<{ copies?: string | string[]; toolbar?: string | string[] }>;
+};
+
+const first = (v: string | string[] | undefined) => (Array.isArray(v) ? v[0] : v);
+
+/** Becomes the PDF's document title (shown in the browser's PDF viewer tab). */
+export async function generateMetadata({ params }: Pick<Props, "params">): Promise<Metadata> {
+  const { id } = await params;
+  const auth = await requireCompany();
+  if (!auth.ok || !mongoose.Types.ObjectId.isValid(id)) return { title: "LR" };
+  await dbConnect();
+  const lr = await ConsignmentModel.findOne({ _id: id, ...companyFilter(auth.companyId) })
+    .select("consignmentNumber")
+    .lean();
+  return { title: lr?.consignmentNumber ? `LR-${lr.consignmentNumber}` : "LR" };
+}
+
+export default async function LrSheetPage({ params, searchParams }: Props) {
+  const { id } = await params;
+  const query = await searchParams;
+
+  if (!mongoose.Types.ObjectId.isValid(id)) notFound();
+
+  const auth = await requireCompany();
+  if (!auth.ok) redirect("/sign-in");
+
+  const parsed = parseCopies(first(query.copies));
+  if (!parsed.ok) notFound();
+
+  await dbConnect();
+  const [record, settings] = await Promise.all([
+    ConsignmentModel.findOne({ _id: id, ...companyFilter(auth.companyId) }).lean(),
+    loadCompanySettings(auth.companyId),
+  ]);
+  if (!record) notFound();
+
+  // Dates / ObjectIds -> plain JSON, the same shape the API returns.
+  const values = JSON.parse(JSON.stringify(record));
+  const copies: (CopyName | undefined)[] = parsed.copies.length
+    ? parsed.copies.map((key) => LR_COPY_LABELS[key] as CopyName)
+    : [undefined]; // single copy with no "LORRY COPY" label
+
+  return (
+    <div className="lr-preview">
+      <LRStyles />
+      {first(query.toolbar) === "1" && (
+        <PrintToolbar title={`LR ${values.consignmentNumber ?? ""}`.trim()} />
+      )}
+      <div className="lr-document">
+        {copies.map((copyName, index) => (
+          <LorryCopy
+            key={copyName ?? `single-${index}`}
+            values={values}
+            copyName={copyName}
+            company={settings}
+            lrFormat={settings.lrFormat}
+          />
+        ))}
+      </div>
+    </div>
+  );
+}
diff --git a/src/app/api/admin/consignments/[id]/pdf/route.ts b/src/app/api/admin/consignments/[id]/pdf/route.ts
new file mode 100644
index 0000000..10f1f2c
--- /dev/null
+++ b/src/app/api/admin/consignments/[id]/pdf/route.ts
@@ -0,0 +1,82 @@
+import { NextRequest, NextResponse } from "next/server";
+import mongoose from "mongoose";
+
+import dbConnect from "@/lib/db";
+import ConsignmentModel from "@/models/Consignment";
+import { companyFilter, requireCompany } from "@/lib/company-scope";
+import { parseCopies } from "@/lib/lr-copies";
+import { ChromiumUnavailableError, renderPageToPdf, SheetLoadError } from "@/lib/lr-pdf";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+// Vercel: Chromium cold start + render. Ignored by self-hosted Node.
+export const maxDuration = 60;
+
+type Ctx = { params: Promise<{ id: string }> };
+
+const fail = (message: string, status: number) =>
+  NextResponse.json({ success: false, message }, { status });
+
+/**
+ * GET /api/admin/consignments/:id/pdf[?copies=consignor,consignee,driver|all]
+ *
+ * Streams the LR as a real PDF so the browser's own viewer opens it — no app
+ * shell, no hydration. The PDF is produced by loading the bare sheet page
+ * (/admin/lr/:id) in headless Chromium with the caller's session.
+ *
+ * If Chromium can't start on this host, redirects to that sheet page with a
+ * Print button instead (the fallback from the Phase 3 plan).
+ */
+export async function GET(request: NextRequest, { params }: Ctx) {
+  const auth = await requireCompany();
+  if (!auth.ok) return auth.response;
+
+  const { id } = await params;
+  if (!mongoose.Types.ObjectId.isValid(id)) return fail("Invalid consignment id", 400);
+
+  const copiesParam = request.nextUrl.searchParams.get("copies");
+  const parsed = parseCopies(copiesParam);
+  if (!parsed.ok) return fail(parsed.message, 400);
+
+  // Ownership check up front: no Chromium launch for ids that aren't theirs.
+  await dbConnect();
+  const lr = await ConsignmentModel.findOne({ _id: id, ...companyFilter(auth.companyId) })
+    .select("consignmentNumber")
+    .lean();
+  if (!lr) return fail("Consignment not found", 404);
+
+  const base = (process.env.PDF_RENDER_BASE_URL || request.nextUrl.origin).replace(/\/$/, "");
+  const sheetPath = `/admin/lr/${encodeURIComponent(id)}`;
+  const qs = copiesParam ? `?copies=${encodeURIComponent(copiesParam)}` : "";
+
+  try {
+    const pdf = await renderPageToPdf({
+      url: `${base}${sheetPath}${qs}`,
+      cookieHeader: request.headers.get("cookie") ?? "",
+    });
+
+    const safeName = String(lr.consignmentNumber ?? id).replace(/[^\w.-]+/g, "_");
+    return new NextResponse(new Uint8Array(pdf), {
+      status: 200,
+      headers: {
+        "Content-Type": "application/pdf",
+        "Content-Disposition": `inline; filename="LR-${safeName}.pdf"`,
+        "Content-Length": String(pdf.length),
+        // Private + uncached: the LR changes when it is edited, and the URL
+        // is only valid for the signed-in company.
+        "Cache-Control": "private, no-store",
+      },
+    });
+  } catch (error) {
+    if (error instanceof ChromiumUnavailableError) {
+      console.error("LR PDF: Chromium unavailable, using the HTML sheet instead.", error.cause);
+      const joiner = qs ? "&" : "?";
+      return NextResponse.redirect(new URL(`${sheetPath}${qs}${joiner}toolbar=1`, request.url));
+    }
+    if (error instanceof SheetLoadError) {
+      return fail(error.message, error.status === 404 ? 404 : 502);
+    }
+    console.error("LR PDF: render failed", error);
+    return fail("Couldn't generate the PDF. Please try again.", 500);
+  }
+}
