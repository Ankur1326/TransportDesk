+      </div>
+
+      <p className="mb-3 text-xs font-semibold uppercase tracking-wide text-gray-500">Bank (for paying this supplier)</p>
+      <div className="form-group mb-5">
+        <FormInput
+          label="Account holder name"
+          value={value.bank.accountHolderName}
+          onChange={(e) => setBank("accountHolderName", e.target.value)}
+        />
+      </div>
+      <div className="form-group mb-5">
+        <FormInput label="Bank name" value={value.bank.bankName} onChange={(e) => setBank("bankName", e.target.value)} />
+      </div>
+      <div className="form-group mb-5">
+        <FormInput
+          label="Account number"
+          value={value.bank.accountNumber}
+          onChange={(e) => setBank("accountNumber", e.target.value.replace(/\s/g, ""))}
+        />
+      </div>
+      <div className="form-group mb-5">
+        <FormInput
+          label="IFSC code"
+          value={value.bank.ifscCode}
+          onChange={(e) => setBank("ifscCode", e.target.value.toUpperCase())}
+          placeholder="HDFC0001234"
+        />
+        {ifscInvalid && <p className={ERROR}>IFSC must look like HDFC0001234.</p>}
+      </div>
+      <div className="form-group mb-2">
+        <FormInput label="UPI ID" value={value.bank.upiId} onChange={(e) => setBank("upiId", e.target.value)} placeholder="name@bank" />
+      </div>
+    </section>
+  );
+}
