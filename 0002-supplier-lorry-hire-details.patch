index 0000000..594723d
--- /dev/null
+++ b/src/lib/supplier/extras.ts
@@ -0,0 +1,112 @@
+/**
+ * The lorry-hire details on a Supplier: Broker / Owner, PAN, default TDS %,
+ * 194C(6) declaration and bank details.
+ *
+ * Browser-safe (zod only) — the Suppliers form and the API share these rules.
+ *
+ * Only keys that are PRESENT in the input appear in the result. That matters on
+ * update: an older client that doesn't send these fields must never wipe them.
+ * `defaultTdsRate: null` means "clear it" (the field was emptied).
+ */
+import { z } from "zod";
+
+import { IFSC_REGEX, PAN_REGEX, SUPPLIER_TYPES, type SupplierType } from "@/lib/lorry-hire/constants";
+
+export interface SupplierBank {
+  accountHolderName: string;
+  bankName: string;
+  accountNumber: string;
+  ifscCode: string;
+  upiId: string;
+}
+
+export interface SupplierExtras {
+  supplierType?: SupplierType;
+  panNumber?: string;
+  /** null = clear the saved default. */
+  defaultTdsRate?: number | null;
+  tdsDeclaration?: boolean;
+  bankDetails?: SupplierBank;
+}
+
+const EXTRA_KEYS = ["supplierType", "panNumber", "defaultTdsRate", "tdsDeclaration", "bankDetails"] as const;
+
+const bankSchema = z.object({
+  accountHolderName: z.string().trim().max(160).default(""),
+  bankName: z.string().trim().max(160).default(""),
+  accountNumber: z
+    .string()
+    .trim()
+    .max(34)
+    .default("")
+    .refine((v) => v === "" || /^[A-Za-z0-9]{6,34}$/.test(v), { message: "Bank account number should be 6–34 letters or digits." }),
+  ifscCode: z
+    .string()
+    .trim()
+    .toUpperCase()
+    .max(11)
+    .default("")
+    .refine((v) => v === "" || IFSC_REGEX.test(v), { message: "IFSC must look like HDFC0001234." }),
+  upiId: z
+    .string()
+    .trim()
+    .max(100)
+    .default("")
+    .refine((v) => v === "" || /^[\w.\-]+@[A-Za-z][A-Za-z0-9.]*$/.test(v), { message: "UPI ID must look like name@bank." }),
+});
+
+const schema = z.object({
+  supplierType: z.enum(SUPPLIER_TYPES, { message: "Supplier type must be Broker or Owner." }),
+  panNumber: z
+    .string()
+    .trim()
+    .toUpperCase()
+    .refine((v) => v === "" || PAN_REGEX.test(v), { message: "PAN must look like ABCDE1234F." }),
+  defaultTdsRate: z
+    .union([z.number(), z.string(), z.null()])
+    .transform((v, ctx) => {
+      if (v === null || (typeof v === "string" && v.trim() === "")) return null;
+      const n = Number(v);
+      if (!Number.isFinite(n) || n < 0 || n > 100) {
+        ctx.addIssue({ code: z.ZodIssueCode.custom, message: "Default TDS must be between 0 and 100." });
+        return z.NEVER;
+      }
+      return Math.round(n * 100) / 100;
+    }),
+  tdsDeclaration: z.boolean({ message: "Declaration must be true or false." }),
+  bankDetails: bankSchema,
+});
+
+export function parseSupplierExtras(body: unknown): { ok: true; values: SupplierExtras } | { ok: false; message: string } {
+  const source = body && typeof body === "object" ? (body as Record<string, unknown>) : {};
+  const present: Record<string, unknown> = {};
+  for (const key of EXTRA_KEYS) {
+    if (source[key] !== undefined) present[key] = source[key];
+  }
+
+  const values: SupplierExtras = {};
+  for (const key of EXTRA_KEYS) {
+    if (!(key in present)) continue;
+    // A null/blank bank block or type is "not provided", not an error.
+    if ((key === "bankDetails" || key === "supplierType") && (present[key] === null || present[key] === "")) continue;
+    if (key === "panNumber" && present[key] === null) {
+      values.panNumber = "";
+      continue;
+    }
+    const result = schema.shape[key].safeParse(present[key]);
+    if (!result.success) return { ok: false, message: result.error.issues[0]?.message ?? "Invalid supplier details." };
+    (values as Record<string, unknown>)[key] = result.data;
+  }
+  return { ok: true, values };
+}
+
+/** A declaration only counts with a valid PAN — returns an error message, or null when fine. */
+export function checkDeclaration(opts: { declaration?: boolean; pan?: string }): string | null {
+  if (opts.declaration && !PAN_REGEX.test((opts.pan ?? "").trim().toUpperCase())) {
+    return "A 194C(6) declaration needs the supplier's valid PAN.";
+  }
+  return null;
+}
+
+/** Everything blank — what the form shows for a supplier with no lorry-hire details yet. */
+export const EMPTY_BANK: SupplierBank = { accountHolderName: "", bankName: "", accountNumber: "", ifscCode: "", upiId: "" };
