@@ -0,0 +1,153 @@
+"use client";
+
+import FormInput from "@/components/FormInput";
+import { suggestTdsRate } from "@/lib/lorry-hire/calculations";
+import { IFSC_REGEX, PAN_REGEX, SUPPLIER_TYPES } from "@/lib/lorry-hire/constants";
+import type { SupplierLorryHireForm } from "@/lib/supplier/form";
+
+interface Props {
+  value: SupplierLorryHireForm;
+  onChange: (next: SupplierLorryHireForm) => void;
+}
+
+const HELP = "text-xs text-gray-500 dark:text-text_secondary";
+const ERROR = "mt-1 text-xs text-red-600";
+
+/**
+ * "Lorry hire details" block of the Supplier modal: Broker/Owner, PAN, default
+ * TDS, 194C(6) declaration and bank details. These pre-fill the lorry hire
+ * contract form when this supplier is picked.
+ */
+export function SupplierLorryHireFields({ value, onChange }: Props) {
+  const set = <K extends keyof SupplierLorryHireForm>(key: K, v: SupplierLorryHireForm[K]) =>
+    onChange({ ...value, [key]: v });
+  const setBank = (key: keyof SupplierLorryHireForm["bank"], v: string) =>
+    onChange({ ...value, bank: { ...value.bank, [key]: v } });
+
+  const pan = value.panNumber.trim().toUpperCase();
+  const panInvalid = pan !== "" && !PAN_REGEX.test(pan);
+  const ifsc = value.bank.ifscCode.trim().toUpperCase();
+  const ifscInvalid = ifsc !== "" && !IFSC_REGEX.test(ifsc);
+
+  const suggestion = suggestTdsRate({ pan, hasDeclaration: value.tdsDeclaration });
+  const current = value.defaultTdsRate.trim();
+  const usingSuggestion = current !== "" && Number(current) === suggestion.rate;
+
+  return (
+    <section aria-labelledby="supplier-lh-heading" className="mt-2 border-t border-gray-200 pt-5 dark:border-border_secondary">
+      <h3 id="supplier-lh-heading" className="text-sm font-semibold text-gray-800 dark:text-gray-200">
+        Lorry hire details
+      </h3>
+      <p className={`${HELP} mb-4`}>Used to pre-fill lorry hire contracts when you pick this supplier.</p>
+
+      <div className="form-group mb-5">
+        <span className="mb-1 block text-sm font-medium text-gray-700 dark:text-text_secondary">Supplier type</span>
+        <div role="tablist" aria-label="Supplier type" className="flex">
+          {SUPPLIER_TYPES.map((t) => {
+            const active = value.supplierType === t;
+            return (
+              <button
