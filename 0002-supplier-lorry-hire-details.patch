diff --git a/src/lib/supplier/__tests__/extras.test.ts b/src/lib/supplier/__tests__/extras.test.ts
new file mode 100644
index 0000000..cf316c3
--- /dev/null
+++ b/src/lib/supplier/__tests__/extras.test.ts
@@ -0,0 +1,72 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+
+import { checkDeclaration, parseSupplierExtras } from "../extras";
+
+const ok = (body: unknown) => {
+  const r = parseSupplierExtras(body);
+  assert.equal(r.ok, true, JSON.stringify(r));
+  return r.ok ? r.values : {};
+};
+const err = (body: unknown) => {
+  const r = parseSupplierExtras(body);
+  assert.equal(r.ok, false);
+  return r.ok ? "" : r.message;
+};
+
+test("an older client that sends none of the fields produces an empty result (nothing gets wiped)", () => {
+  assert.deepEqual(ok({ name: "ABC", city: "Surat" }), {});
+  assert.deepEqual(ok(null), {});
+  assert.deepEqual(ok(undefined), {});
+});
+
+test("valid values are normalised", () => {
+  const v = ok({
+    supplierType: "Owner",
+    panNumber: " abcpe1234f ",
+    defaultTdsRate: "1.234",
+    tdsDeclaration: true,
+    bankDetails: { accountNumber: "123456789012", ifscCode: "hdfc0001234", upiId: "raj@okhdfc" },
+  });
+  assert.equal(v.supplierType, "Owner");
+  assert.equal(v.panNumber, "ABCPE1234F");
+  assert.equal(v.defaultTdsRate, 1.23);
+  assert.equal(v.tdsDeclaration, true);
+  assert.equal(v.bankDetails?.ifscCode, "HDFC0001234");
+  assert.equal(v.bankDetails?.accountHolderName, ""); // missing bank keys default to blank
+});
+
+test("blank PAN is allowed and means 'clear it'; null PAN too", () => {
+  assert.equal(ok({ panNumber: "" }).panNumber, "");
+  assert.equal(ok({ panNumber: null }).panNumber, "");
+});
+
+test("blank default TDS means 'clear it'", () => {
+  assert.equal(ok({ defaultTdsRate: "" }).defaultTdsRate, null);
+  assert.equal(ok({ defaultTdsRate: null }).defaultTdsRate, null);
+  assert.equal(ok({ defaultTdsRate: 0 }).defaultTdsRate, 0);
+});
+
+test("a blank type or bank block is 'not provided', not an error", () => {
+  assert.deepEqual(ok({ supplierType: "", bankDetails: null }), {});
+});
+
+test("bad values are rejected with a clear message", () => {
+  assert.match(err({ panNumber: "BAD" }), /PAN/);
+  assert.match(err({ defaultTdsRate: 101 }), /between 0 and 100/);
+  assert.match(err({ defaultTdsRate: -1 }), /between 0 and 100/);
+  assert.match(err({ defaultTdsRate: "abc" }), /between 0 and 100/);
+  assert.match(err({ supplierType: "Agent" }), /Broker or Owner/);
+  assert.match(err({ tdsDeclaration: "yes" }), /true or false/);
+  assert.match(err({ bankDetails: { ifscCode: "NOPE" } }), /IFSC/);
+  assert.match(err({ bankDetails: { accountNumber: "12" } }), /account number/);
+  assert.match(err({ bankDetails: { upiId: "nobank" } }), /UPI/);
+});
+
+test("a 194C(6) declaration needs a valid PAN", () => {
+  assert.equal(checkDeclaration({ declaration: false, pan: "" }), null);
+  assert.equal(checkDeclaration({ declaration: true, pan: "ABCPE1234F" }), null);
+  assert.equal(checkDeclaration({ declaration: true, pan: "abcpe1234f" }), null);
+  assert.match(checkDeclaration({ declaration: true, pan: "" }) ?? "", /valid PAN/);
+  assert.match(checkDeclaration({ declaration: true, pan: "BAD" }) ?? "", /valid PAN/);
+});
