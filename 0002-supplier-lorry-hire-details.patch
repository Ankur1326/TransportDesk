+/**
+ * Form-state helpers for the lorry-hire section of the Supplier modal.
+ * Pure and browser-safe: saved supplier <-> form fields <-> request payload.
+ */
+import type { SupplierType } from "@/lib/lorry-hire/constants";
+
+import { EMPTY_BANK, type SupplierBank } from "./extras";
+
+export interface SupplierLorryHireForm {
+  supplierType: SupplierType;
+  panNumber: string;
+  /** Text so the user can clear it; "" means no default. */
+  defaultTdsRate: string;
+  tdsDeclaration: boolean;
+  bank: SupplierBank;
+}
+
+export const EMPTY_LORRY_HIRE_FORM: SupplierLorryHireForm = {
+  supplierType: "Broker",
+  panNumber: "",
+  defaultTdsRate: "",
+  tdsDeclaration: false,
+  bank: { ...EMPTY_BANK },
+};
+
+/** A saved supplier (possibly from before these fields existed) -> form state. */
+export function toLorryHireForm(
+  s?: {
+    supplierType?: string;
+    panNumber?: string;
+    defaultTdsRate?: number | null;
+    tdsDeclaration?: boolean;
+    bankDetails?: Partial<SupplierBank> | null;
+  } | null
+): SupplierLorryHireForm {
+  if (!s) return { ...EMPTY_LORRY_HIRE_FORM, bank: { ...EMPTY_BANK } };
+  return {
+    supplierType: s.supplierType === "Owner" ? "Owner" : "Broker",
+    panNumber: s.panNumber ?? "",
+    defaultTdsRate: typeof s.defaultTdsRate === "number" ? String(s.defaultTdsRate) : "",
+    tdsDeclaration: !!s.tdsDeclaration,
+    bank: { ...EMPTY_BANK, ...(s.bankDetails ?? {}) },
+  };
+}
+
+/** Form state -> the fields sent to the API. A blank default TDS is sent as null so it clears. */
+export function toExtrasPayload(f: SupplierLorryHireForm) {
+  const rate = f.defaultTdsRate.trim();
+  return {
+    supplierType: f.supplierType,
+    panNumber: f.panNumber.trim().toUpperCase(),
+    defaultTdsRate: rate === "" ? null : Number(rate),
+    tdsDeclaration: f.tdsDeclaration,
+    bankDetails: { ...f.bank, ifscCode: f.bank.ifscCode.trim().toUpperCase() },
+  };
+}
diff --git a/src/lib/supplier/service.ts b/src/lib/supplier/service.ts
