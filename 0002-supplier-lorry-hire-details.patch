index 0000000..161b06b
--- /dev/null
+++ b/src/lib/supplier/service.ts
@@ -0,0 +1,215 @@
+/**
+ * Supplier create / update / delete — the logic behind /api/admin/supplier/*.
+ * Server-only. The routes stay thin (auth -> JSON -> here -> respond) so every
+ * rule can be tested against a real database.
+ *
+ * What this adds on top of the original routes
+ *  - Saves and validates the lorry-hire details (Broker/Owner, PAN, default TDS %,
+ *    194C(6) declaration, bank). Fields an older client doesn't send are left alone.
+ *  - Duplicate names are matched case-insensitively — the same rule the lorry hire
+ *    form uses to link a typed supplier to a saved one — so "ABC Roadlines" and
+ *    "abc roadlines" can't both exist.
+ *  - Renaming a supplier refreshes the party name on its supplier-ledger payment rows.
+ *  - A supplier with active (non-cancelled) lorry hire contracts can't be deleted.
+ */
+import mongoose from "mongoose";
+
+import { companyFilter } from "@/lib/company-filter";
+import dbConnect from "@/lib/db";
+import { dropLegacyUniqueIndex } from "@/lib/legacy-indexes";
+import { parseOpeningBalance } from "@/lib/opening-balance";
+import LorryHireModel from "@/models/LorryHire";
+import PaymentModel from "@/models/Payment";
+import Supplier, { type ISupplier } from "@/models/Supplier";
+
+import { checkDeclaration, parseSupplierExtras } from "./extras";
+
+export interface SupplierContext {
+  companyId: string;
+  userId: string;
+}
+
+export type SupplierResult<T = ISupplier> =
+  | { ok: true; status: number; message: string; data?: T }
+  | { ok: false; status: number; message: string };
+
+const fail = (status: number, message: string): SupplierResult<never> => ({ ok: false, status, message });
+
+/** Case-insensitive exact matching for names (same collation the ledger code uses). */
+const CI = { locale: "en", strength: 2 } as const;
+
+const isDuplicateKey = (error: unknown): boolean =>
+  !!error && typeof error === "object" && (error as { code?: number }).code === 11000;
+
+const str = (v: unknown): string => (typeof v === "string" ? v.trim() : "");
+
+type SupplierLean = ISupplier & { _id: mongoose.Types.ObjectId };
+
+const findByName = (ctx: SupplierContext, name: string, excludeId?: string) =>
+  Supplier.findOne({
+    $and: [companyFilter(ctx.companyId), { name }, ...(excludeId ? [{ _id: { $ne: excludeId } }] : [])],
+  })
+    .collation(CI)
+    .select("_id")
+    .lean();
+
+// ─── Create ──────────────────────────────────────────────────────────────────
+
+export async function createSupplierRecord(ctx: SupplierContext, body: unknown): Promise<SupplierResult> {
+  const b = (body && typeof body === "object" ? body : {}) as Record<string, unknown>;
+
+  const name = str(b.name);
+  if (!name) return fail(400, "Supplier name is required.");
+
+  const balance = parseOpeningBalance(b.openingBalance, b.balanceType);
+  if (!balance.ok) return fail(400, balance.message);
+
+  const extras = parseSupplierExtras(b);
+  if (!extras.ok) return fail(400, extras.message);
+  const x = extras.values;
+
+  const declarationError = checkDeclaration({ declaration: x.tdsDeclaration, pan: x.panNumber });
+  if (declarationError) return fail(400, declarationError);
+
+  await dbConnect();
+  await dropLegacyUniqueIndex(Supplier, "name");
+
+  if (await findByName(ctx, name)) return fail(400, "Supplier with this name already exists");
+
+  try {
+    const created = await Supplier.create({
+      name,
+      address: str(b.address),
+      city: str(b.city),
+      state: str(b.state),
+      pincode: str(b.pincode),
+      gstin: str(b.gstin),
+      mobile: str(b.mobile) || null,
+      email: str(b.email),
+      openingBalance: balance.openingBalance,
+      balanceType: balance.balanceType,
+      ...(x.supplierType ? { supplierType: x.supplierType } : {}),
+      ...(x.panNumber !== undefined ? { panNumber: x.panNumber } : {}),
+      ...(typeof x.defaultTdsRate === "number" ? { defaultTdsRate: x.defaultTdsRate } : {}),
+      ...(x.tdsDeclaration !== undefined ? { tdsDeclaration: x.tdsDeclaration } : {}),
+      ...(x.bankDetails ? { bankDetails: x.bankDetails } : {}),
+      // Server-controlled — never taken from the request body.
+      companyId: ctx.companyId,
+      createdBy: ctx.userId,
+    });
+    return { ok: true, status: 200, message: "New Supplier tag created successfully", data: created };
+  } catch (error) {
+    if (isDuplicateKey(error)) return fail(400, "Supplier with this name already exists");
+    if (error instanceof mongoose.Error.ValidationError) return fail(400, error.message);
+    throw error;
+  }
+}
+
+// ─── Update ──────────────────────────────────────────────────────────────────
+
+export async function updateSupplierRecord(ctx: SupplierContext, body: unknown): Promise<SupplierResult> {
+  const b = (body && typeof body === "object" ? body : {}) as Record<string, unknown>;
+
+  const id = typeof b._id === "string" ? b._id : "";
+  if (!id) return fail(400, "supplierId is required");
+  if (!mongoose.Types.ObjectId.isValid(id)) return fail(400, "Invalid supplier id");
+
+  const balance = parseOpeningBalance(b.openingBalance, b.balanceType);
+  if (!balance.ok) return fail(400, balance.message);
+
+  const extras = parseSupplierExtras(b);
+  if (!extras.ok) return fail(400, extras.message);
+  const x = extras.values;
+
+  await dbConnect();
+  const current = await Supplier.findOne({ _id: id, ...companyFilter(ctx.companyId) }).lean<SupplierLean>();
+  if (!current) return fail(404, "Supplier not found");
+
+  const name = b.name === undefined ? current.name : str(b.name);
+  if (!name) return fail(400, "Supplier name is required.");
+  if (name.toLowerCase() !== current.name.toLowerCase() && (await findByName(ctx, name, id))) {
+    return fail(400, "Supplier with this name already exists");
+  }
+
+  // The declaration is judged against the PAN the supplier will have AFTER this save.
+  const declarationError = checkDeclaration({
+    declaration: x.tdsDeclaration ?? current.tdsDeclaration,
+    pan: x.panNumber ?? current.panNumber,
+  });
+  if (declarationError) return fail(400, declarationError);
+
+  const $set: Record<string, unknown> = {
+    name,
+    openingBalance: balance.openingBalance,
+    balanceType: balance.balanceType,
+  };
+  // Plain text fields: only touched when the client sent them.
+  for (const key of ["address", "city", "state", "pincode", "gstin", "email"] as const) {
+    if (b[key] !== undefined) $set[key] = str(b[key]);
+  }
+  if (b.mobile !== undefined) $set.mobile = str(b.mobile) || null;
+
+  if (x.supplierType) $set.supplierType = x.supplierType;
+  if (x.panNumber !== undefined) $set.panNumber = x.panNumber;
+  if (typeof x.defaultTdsRate === "number") $set.defaultTdsRate = x.defaultTdsRate;
+  if (x.tdsDeclaration !== undefined) $set.tdsDeclaration = x.tdsDeclaration;
+  if (x.bankDetails) $set.bankDetails = x.bankDetails;
+
+  const update: Record<string, unknown> = { $set };
+  if (x.defaultTdsRate === null) update.$unset = { defaultTdsRate: "" };
+
+  let updated: SupplierLean | null;
+  try {
+    updated = await Supplier.findOneAndUpdate({ _id: id, ...companyFilter(ctx.companyId) }, update, {
+      new: true,
+      runValidators: true,
+    }).lean<SupplierLean>();
+  } catch (error) {
+    if (isDuplicateKey(error)) return fail(400, "Supplier with this name already exists");
+    if (error instanceof mongoose.Error.ValidationError) return fail(400, error.message);
+    throw error;
+  }
+  if (!updated) return fail(404, "Supplier not found");
+
+  // Keep the ledger's party name in step. The contracts keep the name they were issued with.
+  if (updated.name !== current.name) {
+    try {
+      await PaymentModel.updateMany(
+        { $and: [companyFilter(ctx.companyId), { partyType: "supplier", partyId: updated._id }] },
+        { $set: { partyName: updated.name } }
+      );
+    } catch (error) {
+      console.error("Supplier rename: couldn't refresh ledger party names", error);
+    }
+  }
+
+  return { ok: true, status: 200, message: "Supplier updated successfully", data: updated };
+}
+
+// ─── Delete ──────────────────────────────────────────────────────────────────
+
+export async function deleteSupplierRecord(ctx: SupplierContext, supplierId: unknown): Promise<SupplierResult> {
+  if (typeof supplierId !== "string" || !supplierId) return fail(400, "Supplier ID is required.");
+  if (!mongoose.Types.ObjectId.isValid(supplierId)) return fail(400, "Invalid supplier id");
+
+  await dbConnect();
+
+  // Cancelled contracts are history and don't block; anything live does.
+  const active = await LorryHireModel.countDocuments({
+    ...companyFilter(ctx.companyId),
+    "supplier.supplierId": new mongoose.Types.ObjectId(supplierId),
+    status: { $ne: "Cancelled" },
+  });
+  if (active > 0) {
+    return fail(
+      409,
+      `This supplier is on ${active} lorry hire contract${active === 1 ? "" : "s"}. Cancel or reassign ${
+        active === 1 ? "it" : "them"
+      } before deleting the supplier.`
+    );
+  }
+
+  const result = await Supplier.deleteOne({ _id: supplierId, ...companyFilter(ctx.companyId) });
+  if (result.deletedCount === 0) return fail(404, "Supplier not found.");
+  return { ok: true, status: 200, message: "Supplier deleted successfully." };
+}
