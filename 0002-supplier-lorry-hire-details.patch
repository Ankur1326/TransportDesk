+import { test } from "node:test";
+import assert from "node:assert/strict";
+
+import { checkDeclaration, parseSupplierExtras } from "../extras";
+import { EMPTY_LORRY_HIRE_FORM, toExtrasPayload, toLorryHireForm } from "../form";
+
+test("a supplier from before these fields existed maps to sensible blanks", () => {
+  const f = toLorryHireForm({ supplierType: undefined, panNumber: undefined });
+  assert.equal(f.supplierType, "Broker");
+  assert.equal(f.panNumber, "");
+  assert.equal(f.defaultTdsRate, "");
+  assert.equal(f.tdsDeclaration, false);
+  assert.deepEqual(f.bank, EMPTY_LORRY_HIRE_FORM.bank);
+  assert.deepEqual(toLorryHireForm(null), EMPTY_LORRY_HIRE_FORM);
+});
+
+test("a saved supplier maps to form text, and a TDS of 0 is kept (not treated as blank)", () => {
+  const f = toLorryHireForm({
+    supplierType: "Owner",
+    panNumber: "ABCPE1234F",
+    defaultTdsRate: 0,
+    tdsDeclaration: true,
+    bankDetails: { bankName: "HDFC", accountNumber: "123456789012" },
+  });
+  assert.equal(f.supplierType, "Owner");
+  assert.equal(f.defaultTdsRate, "0");
+  assert.equal(f.bank.bankName, "HDFC");
+  assert.equal(f.bank.ifscCode, ""); // missing bank keys are blank, never undefined
+});
+
+test("form -> payload: blank TDS becomes null (clear), values are normalised", () => {
+  const blank = toExtrasPayload({ ...EMPTY_LORRY_HIRE_FORM });
+  assert.equal(blank.defaultTdsRate, null);
+  assert.equal(blank.panNumber, "");
+
+  const p = toExtrasPayload({
+    ...EMPTY_LORRY_HIRE_FORM,
+    panNumber: " abcpe1234f ",
+    defaultTdsRate: "1",
+    bank: { ...EMPTY_LORRY_HIRE_FORM.bank, ifscCode: "hdfc0001234" },
+  });
+  assert.equal(p.panNumber, "ABCPE1234F");
+  assert.equal(p.defaultTdsRate, 1);
+  assert.equal(p.bankDetails.ifscCode, "HDFC0001234");
+});
+
+test("an untouched (empty) form always produces a payload the API accepts", () => {
+  const r = parseSupplierExtras(toExtrasPayload({ ...EMPTY_LORRY_HIRE_FORM }));
+  assert.equal(r.ok, true);
+  assert.equal(checkDeclaration({ declaration: false, pan: "" }), null);
+});
+
+test("round trip: saved supplier -> form -> payload is accepted and unchanged", () => {
+  const saved = {
+    supplierType: "Owner",
+    panNumber: "ABCCE1234F",
+    defaultTdsRate: 2,
+    tdsDeclaration: false,
+    bankDetails: { accountHolderName: "X", bankName: "SBI", accountNumber: "1234567890", ifscCode: "SBIN0001234", upiId: "x@sbi" },
+  };
+  const payload = toExtrasPayload(toLorryHireForm(saved));
+  const r = parseSupplierExtras(payload);
+  assert.equal(r.ok, true);
+  if (r.ok) {
+    assert.equal(r.values.panNumber, saved.panNumber);
+    assert.equal(r.values.defaultTdsRate, 2);
+    assert.deepEqual(r.values.bankDetails, saved.bankDetails);
+  }
+});
diff --git a/src/lib/supplier/__tests__/service.int.test.ts b/src/lib/supplier/__tests__/service.int.test.ts
new file mode 100644
index 0000000..7ec3f0e
--- /dev/null
+++ b/src/lib/supplier/__tests__/service.int.test.ts
@@ -0,0 +1,250 @@
+/**
+ * Integration tests against a real MongoDB. Skipped unless TEST_MONGODB_URI is
+ * set, e.g.  TEST_MONGODB_URI=mongodb://127.0.0.1:27017 npm test
+ * Each run uses its own throw-away database, dropped at the end.
+ */
+import { after, before, test } from "node:test";
+import assert from "node:assert/strict";
+import mongoose from "mongoose";
+
+const URI = process.env.TEST_MONGODB_URI;
+const skip = URI ? false : "set TEST_MONGODB_URI to run the supplier integration tests";
+
+// Real user ids are ObjectIds (Supplier.createdBy is one).
+const A = { companyId: "company-a", userId: new mongoose.Types.ObjectId().toString() };
+const B = { companyId: "company-b", userId: new mongoose.Types.ObjectId().toString() };
+
+type Svc = typeof import("../service");
+let svc: Svc;
+let Supplier: typeof import("@/models/Supplier").default;
+let LorryHire: typeof import("@/models/LorryHire").default;
+let Payment: typeof import("@/models/Payment").default;
+
+before(async () => {
+  if (!URI) return;
+  process.env.MONGODB_URI = URI;
+  process.env.MONGODB_DB_NAME = `supplier_test_${Date.now()}`;
+  svc = await import("../service");
+  Supplier = (await import("@/models/Supplier")).default;
+  LorryHire = (await import("@/models/LorryHire")).default;
+  Payment = (await import("@/models/Payment")).default;
+  const { default: dbConnect } = await import("@/lib/db");
+  await dbConnect();
+  await Promise.all([Supplier.init(), LorryHire.init(), Payment.init()]);
+});
+
+after(async () => {
+  if (!URI) return;
+  await mongoose.connection.dropDatabase();
+  await mongoose.disconnect();
+});
+
+const create = async (ctx = A, body: Record<string, unknown> = {}) => {
+  const r = await svc.createSupplierRecord(ctx, { name: `Supplier ${Math.random().toString(36).slice(2, 8)}`, ...body });
+  return r;
+};
+const created = async (ctx = A, body: Record<string, unknown> = {}) => {
+  const r = await create(ctx, body);
+  assert.equal(r.ok, true, r.message);
+  return r.ok ? (r.data as unknown as { _id: mongoose.Types.ObjectId; name: string }) : (undefined as never);
+};
+
+const contract = (supplierId: mongoose.Types.ObjectId, status: string, companyId = A.companyId) =>
+  LorryHire.create({
+    lhcNo: `LHC/${Math.floor(Math.random() * 1e9)}`,
+    lhcDate: new Date(),
+    from: { location: "Surat" },
+    to: { location: "Nagpur" },
+    supplier: { supplierId, name: "x" },
+    truck: { vehicleNumber: "MH23AU6718" },
+    status,
+    companyId,
+  });
+
+test("create: saves the lorry hire details", { skip }, async () => {
+  const r = await create(A, {
+    name: "Shree Roadlines",
+    supplierType: "Owner",
+    panNumber: "abcpe1234f",
+    defaultTdsRate: 1,
+    tdsDeclaration: true,
+    bankDetails: { accountHolderName: "Shree", bankName: "HDFC", accountNumber: "123456789012", ifscCode: "hdfc0001234", upiId: "shree@okhdfc" },
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.status, 200); // the Redux slice checks for exactly 200
+  const s = await Supplier.findOne({ name: "Shree Roadlines", companyId: A.companyId }).lean();
+  assert.equal(s?.supplierType, "Owner");
+  assert.equal(s?.panNumber, "ABCPE1234F");
+  assert.equal(s?.defaultTdsRate, 1);
+  assert.equal(s?.tdsDeclaration, true);
+  assert.equal(s?.bankDetails?.ifscCode, "HDFC0001234");
+  assert.equal(String(s?.createdBy), A.userId); // taken from the session, never the body
+});
+
+test("create: an older client (no new fields) still works and gets defaults", { skip }, async () => {
+  const s = await created(A, { name: "Old Client Roadways", city: "Surat", openingBalance: 500, balanceType: "credit" });
+  const doc = await Supplier.findById(s._id).lean();
+  assert.equal(doc?.supplierType, "Broker");
+  assert.equal(doc?.panNumber, "");
+  assert.equal(doc?.tdsDeclaration, false);
+  assert.equal(doc?.defaultTdsRate, undefined);
+  assert.equal(doc?.openingBalance, 500);
+  assert.equal(doc?.balanceType, "credit");
+});
+
+test("create: rejects bad input", { skip }, async () => {
+  const cases: [Record<string, unknown>, RegExp][] = [
+    [{ name: "  " }, /name is required/i],
+    [{ panNumber: "BAD" }, /PAN/],
+    [{ defaultTdsRate: 150 }, /between 0 and 100/],
+    [{ bankDetails: { ifscCode: "X" } }, /IFSC/],
+    [{ tdsDeclaration: true }, /needs the supplier's valid PAN/],
+    [{ openingBalance: -5 }, /Opening balance/],
+  ];
+  for (const [body, re] of cases) {
+    const r = await create(A, body);
+    assert.equal(r.ok, false, JSON.stringify(body));
+    assert.equal(r.status, 400);
+    assert.match(r.message, re);
+  }
+});
+
+test("create: duplicate names are caught case-insensitively, but only within a company", { skip }, async () => {
+  await created(A, { name: "Case Roadlines" });
+  const dup = await create(A, { name: "case ROADLINES" });
+  assert.equal(dup.ok, false);
+  assert.equal(dup.status, 400);
+  assert.match(dup.message, /already exists/);
+
+  const otherCompany = await create(B, { name: "Case Roadlines" });
+  assert.equal(otherCompany.ok, true);
+});
+
+test("update: an older client that omits the new fields does NOT wipe them", { skip }, async () => {
+  const s = await created(A, {
+    name: "Keep Me Transport",
+    supplierType: "Owner",
+    panNumber: "ABCPE1234F",
+    defaultTdsRate: 2,
+    tdsDeclaration: true,
+    bankDetails: { accountNumber: "999988887777", ifscCode: "HDFC0001234" },
+  });
+  const r = await svc.updateSupplierRecord(A, { _id: String(s._id), name: "Keep Me Transport", city: "Pune", openingBalance: 10, balanceType: "debit" });
+  assert.equal(r.ok, true, r.message);
+  const doc = await Supplier.findById(s._id).lean();
+  assert.equal(doc?.city, "Pune");
+  assert.equal(doc?.supplierType, "Owner");
+  assert.equal(doc?.panNumber, "ABCPE1234F");
+  assert.equal(doc?.defaultTdsRate, 2);
+  assert.equal(doc?.tdsDeclaration, true);
+  assert.equal(doc?.bankDetails?.accountNumber, "999988887777");
+});
+
+test("update: sets, changes and clears the lorry hire details", { skip }, async () => {
+  const s = await created(A, { name: "Change Me Carriers" });
+  const id = String(s._id);
+
+  let r = await svc.updateSupplierRecord(A, {
+    _id: id, name: "Change Me Carriers", supplierType: "Owner", panNumber: "abcce1234f", defaultTdsRate: "2",
+    bankDetails: { accountHolderName: "CMC", bankName: "SBI", accountNumber: "1234567890", ifscCode: "sbin0001234", upiId: "" },
+  });
+  assert.equal(r.ok, true, r.message);
+  let doc = await Supplier.findById(id).lean();
+  assert.equal(doc?.panNumber, "ABCCE1234F");
+  assert.equal(doc?.defaultTdsRate, 2);
+  assert.equal(doc?.bankDetails?.ifscCode, "SBIN0001234");
+
+  r = await svc.updateSupplierRecord(A, { _id: id, name: "Change Me Carriers", defaultTdsRate: "", panNumber: "" });
+  assert.equal(r.ok, true, r.message);
+  doc = await Supplier.findById(id).lean();
+  assert.equal(doc?.defaultTdsRate, undefined); // cleared
+  assert.equal(doc?.panNumber, "");
+  assert.equal(doc?.supplierType, "Owner"); // untouched
+});
+
+test("update: the declaration is checked against the PAN the supplier will have", { skip }, async () => {
+  const s = await created(A, { name: "Declaration Co", panNumber: "ABCPE1234F", tdsDeclaration: true });
+  const id = String(s._id);
+
+  // Removing the PAN while the declaration stays on is refused...
+  let r = await svc.updateSupplierRecord(A, { _id: id, name: "Declaration Co", panNumber: "" });
+  assert.equal(r.ok, false);
+  assert.match(r.message, /valid PAN/);
+  // ...but removing both together is fine.
+  r = await svc.updateSupplierRecord(A, { _id: id, name: "Declaration Co", panNumber: "", tdsDeclaration: false });
+  assert.equal(r.ok, true, r.message);
+});
+
+test("update: renaming rejects duplicates, allows a case-only change", { skip }, async () => {
+  await created(A, { name: "Taken Name" });
+  const s = await created(A, { name: "Rename Source" });
+  const id = String(s._id);
+
+  let r = await svc.updateSupplierRecord(A, { _id: id, name: "taken name" });
+  assert.equal(r.ok, false);
+  assert.match(r.message, /already exists/);
+
+  r = await svc.updateSupplierRecord(A, { _id: id, name: "RENAME SOURCE" });
+  assert.equal(r.ok, true, r.message);
+  assert.equal((await Supplier.findById(id).lean())?.name, "RENAME SOURCE");
+});
+
+test("update: renaming refreshes the supplier-ledger party name", { skip }, async () => {
+  const s = await created(A, { name: "Ledger Rename Old" });
+  await Payment.create({
+    companyId: A.companyId, partyType: "supplier", partyId: s._id, partyName: "Ledger Rename Old",
+    direction: "paid", amount: 100, date: new Date(), mode: "Cash",
+  });
+  const unrelated = await Payment.create({
+    companyId: A.companyId, partyType: "customer", partyId: s._id, partyName: "Should Stay",
+    direction: "received", amount: 50, date: new Date(), mode: "Cash",
+  });
+
+  const r = await svc.updateSupplierRecord(A, { _id: String(s._id), name: "Ledger Rename New" });
+  assert.equal(r.ok, true, r.message);
+  assert.equal((await Payment.findOne({ partyId: s._id, partyType: "supplier" }).lean())?.partyName, "Ledger Rename New");
+  assert.equal((await Payment.findById(unrelated._id).lean())?.partyName, "Should Stay");
+});
+
+test("update: another company's supplier is not found; bad ids are rejected", { skip }, async () => {
+  const s = await created(A, { name: "Tenant Guard" });
+  const r = await svc.updateSupplierRecord(B, { _id: String(s._id), name: "Hijacked" });
+  assert.equal(r.ok, false);
+  assert.equal(r.status, 404);
+  assert.equal((await Supplier.findById(s._id).lean())?.name, "Tenant Guard");
+
+  assert.equal((await svc.updateSupplierRecord(A, { name: "x" })).status, 400);
+  assert.equal((await svc.updateSupplierRecord(A, { _id: "nope", name: "x" })).status, 400);
+});
+
+test("delete: blocked while a live contract uses the supplier, allowed once it is cancelled", { skip }, async () => {
+  const s = await created(A, { name: "Delete Guard" });
+  const hire = await contract(s._id, "Hired");
+
+  let r = await svc.deleteSupplierRecord(A, String(s._id));
+  assert.equal(r.ok, false);
+  assert.equal(r.status, 409);
+  assert.match(r.message, /1 lorry hire contract/);
+  assert.ok(await Supplier.exists({ _id: s._id }));
+
+  await LorryHire.updateOne({ _id: hire._id }, { $set: { status: "Cancelled" } });
+  r = await svc.deleteSupplierRecord(A, String(s._id));
+  assert.equal(r.ok, true, r.message);
+  assert.equal(await Supplier.exists({ _id: s._id }), null);
+});
+
+test("delete: other company, unknown and invalid ids", { skip }, async () => {
+  const s = await created(A, { name: "Delete Tenant" });
+  assert.equal((await svc.deleteSupplierRecord(B, String(s._id))).status, 404);
+  assert.ok(await Supplier.exists({ _id: s._id }));
+  assert.equal((await svc.deleteSupplierRecord(A, new mongoose.Types.ObjectId().toString())).status, 404);
+  assert.equal((await svc.deleteSupplierRecord(A, "bad")).status, 400);
+  assert.equal((await svc.deleteSupplierRecord(A, undefined)).status, 400);
+});
+
+test("delete: another company's contracts don't block", { skip }, async () => {
+  const s = await created(A, { name: "Cross Tenant Contract" });
+  await contract(s._id, "Hired", B.companyId); // same id, wrong company — must be ignored
+  const r = await svc.deleteSupplierRecord(A, String(s._id));
+  assert.equal(r.ok, true, r.message);
+});
